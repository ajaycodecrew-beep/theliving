
{% assign free_shipping_threshold = 1000000 %}
{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}
{% assign progress = cart_total | times: 100.0 | divided_by: free_shipping_threshold %}

{% if progress > 100 %}
  {% assign progress = 100 %}
{% endif %}

<div
  class="free-shipping-progress-wrapper"
  data-free-shipping-progress
  data-threshold="{{ free_shipping_threshold }}"
  data-cart-total="{{ cart_total }}"
>
  {% if remaining_amount > 0 %}
    <p class="free-shipping-progress__message">
      You're only <strong>{{ remaining_amount | money }}</strong>
      away from free shipping!
    </p>
  {% else %}
    <p class="free-shipping-progress__message success">
      Congratulations! You've unlocked free shipping!
    </p>
  {% endif %}

  <div class="free-shipping-progress__track">
    <div
      class="free-shipping-progress__fill"
      style="width: {{ progress }}%"
    ></div>
  </div>

  <div class="free-shipping-progress__labels">
    <span>{{ cart_total | money }}</span>
    <span>{{ free_shipping_threshold | money }}</span>
  </div>
</div>
